<Window x:Class="VirtualFunctions.App.Views.ButtonManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VirtualFunctions.App.ViewModels"
        xmlns:models="clr-namespace:VirtualFunctions.Core.Models;assembly=VirtualFunctions.Core"
        Title="ボタンマネージャ"
        Width="640"
        Height="520"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:ButtonManagerViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Preset toolbar -->
        <GroupBox Grid.Row="0" Header="プリセット" Padding="8">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Padding="10,2" Content="適用"
                            ToolTip="このプリセットをフローティングキーボードに表示"
                            Command="{Binding ApplyPresetCommand}" />
                    <ComboBox Margin="0,0,8,0"
                              ItemsSource="{Binding PresetNames}"
                              SelectedItem="{Binding SelectedPresetName}" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Padding="8,2" Margin="0,0,6,0" Content="新規" Command="{Binding NewPresetCommand}" />
                    <Button Padding="8,2" Margin="0,0,6,0" Content="複製" Command="{Binding DuplicatePresetCommand}" />
                    <Button Padding="8,2" Margin="0,0,6,0" Content="名前変更" Command="{Binding RenamePresetCommand}" />
                    <Button Padding="8,2" Margin="0,0,6,0" Content="削除" Command="{Binding DeletePresetCommand}" />
                    <Separator Width="12" Visibility="Hidden" />
                    <Button Padding="8,2" Margin="0,0,6,0" Content="インポート..." Click="OnImportPreset" />
                    <Button Padding="8,2" Content="エクスポート..." Click="OnExportPreset" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <!-- Button list -->
            <GroupBox Grid.Column="0" Header="ボタン" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Padding="8,2" Margin="0,0,6,0" Content="追加" Command="{Binding AddButtonCommand}" />
                        <Button Padding="8,2" Margin="0,0,6,0" Content="編集" Command="{Binding EditButtonCommand}" />
                        <Button Padding="8,2" Margin="0,0,6,0" Content="複製" Command="{Binding DuplicateButtonCommand}" />
                        <Button Padding="8,2" Content="削除" Command="{Binding RemoveButtonCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Buttons}"
                             SelectedItem="{Binding SelectedButton}"
                             MouseDoubleClick="OnButtonListDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ButtonDefinition}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="36"
                                               FontFamily="Segoe UI, Segoe UI Emoji"
                                               Text="{Binding Icon.Value}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Width="120" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="Gray" Text="{Binding Key}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <!-- Reorder -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                <Button Width="32" Height="28" Margin="0,0,0,6" Content="▲" Command="{Binding MoveButtonUpCommand}" />
                <Button Width="32" Height="28" Content="▼" Command="{Binding MoveButtonDownCommand}" />
            </StackPanel>

            <!-- App binding -->
            <GroupBox Grid.Column="2" Header="アプリ連動" Padding="8">
                <StackPanel>
                    <CheckBox Content="アプリ連動を有効化（全体）"
                              Margin="0,0,0,8"
                              IsChecked="{Binding AppBindingGloballyEnabled}"
                              ToolTip="前面ウィンドウに応じてプリセットを自動切替します" />
                    <TextBlock Text="どれにも一致しない時:" Margin="0,0,0,2" />
                    <ComboBox Margin="0,0,0,8"
                              ItemsSource="{Binding FallbackOptions}"
                              SelectedItem="{Binding SelectedFallbackOption}"
                              IsEnabled="{Binding AppBindingGloballyEnabled}"
                              ToolTip="前面アプリがどの連動設定にも一致しない時に表示するプリセット" />
                    <Separator Margin="0,0,0,8" />
                    <CheckBox Content="このプリセットを連動させる"
                              Margin="0,0,0,6"
                              IsChecked="{Binding BindingEnabled}" />
                    <Button Margin="0,0,0,8"
                            Padding="8,4"
                            HorizontalAlignment="Stretch"
                            Content="実行中のアプリから選択..."
                            Command="{Binding PickBindingWindowCommand}" />
                    <TextBlock Text="一致パターン:" Margin="0,0,0,2" />
                    <TextBox Margin="0,0,0,6"
                             Text="{Binding BindingPattern, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             IsEnabled="{Binding BindingEnabled}" />
                    <TextBlock Text="一致対象:" Margin="0,0,0,2" />
                    <ComboBox Margin="0,0,0,6"
                              IsEnabled="{Binding BindingEnabled}"
                              SelectedItem="{Binding BindingTarget}">
                        <ComboBox.ItemsSource>
                            <x:Array Type="models:BindingTarget">
                                <models:BindingTarget>WindowTitle</models:BindingTarget>
                                <models:BindingTarget>ProcessName</models:BindingTarget>
                                <models:BindingTarget>ClassName</models:BindingTarget>
                            </x:Array>
                        </ComboBox.ItemsSource>
                    </ComboBox>
                    <TextBlock Text="一致方法:" Margin="0,0,0,2" />
                    <ComboBox Margin="0,0,0,6"
                              IsEnabled="{Binding BindingEnabled}"
                              SelectedItem="{Binding BindingMatch}">
                        <ComboBox.ItemsSource>
                            <x:Array Type="models:BindingMatch">
                                <models:BindingMatch>Partial</models:BindingMatch>
                                <models:BindingMatch>Exact</models:BindingMatch>
                            </x:Array>
                        </ComboBox.ItemsSource>
                    </ComboBox>
                    <TextBlock Text="優先度（大きいほど優先）:" Margin="0,0,0,2" />
                    <TextBox Text="{Binding BindingPriority, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             IsEnabled="{Binding BindingEnabled}" />
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>

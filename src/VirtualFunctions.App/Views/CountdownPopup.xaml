<Window x:Class="VirtualFunctions.App.Views.CountdownPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Background="{x:Null}">
    <Border Padding="10,6"
            CornerRadius="6"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource DelayArmedBorderBrush}"
            BorderThickness="2">
        <TextBlock x:Name="CountdownText"
                   FontFamily="Segoe UI, Segoe UI Emoji"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ButtonForegroundBrush}" />
    </Border>
</Window>

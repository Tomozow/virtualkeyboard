<Window x:Class="VirtualFunctions.App.Views.FloatingKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VirtualFunctions.App.Converters"
        xmlns:vm="clr-namespace:VirtualFunctions.App.ViewModels"
        Title="Virtual Functions"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Background="{x:Null}"
        d:DataContext="{d:DesignInstance Type=vm:FloatingKeyboardViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <conv:ColorStringToBrushConverter x:Key="ColorToBrush" />
        <Style x:Key="KeyButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Padding="6"
            CornerRadius="8"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Border.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="ボタンマネージャ..." Command="{Binding OpenManagerCommand}" />
                <Separator />
                <MenuItem Header="レイアウト切替（横 / 縦）" Command="{Binding ToggleLayoutCommand}" />
                <MenuItem Header="テーマ切替（ライト / ダーク）" Command="{Binding ToggleThemeCommand}" />
                <Separator />
                <MenuItem Header="終了" Command="{Binding ExitCommand}" />
            </ContextMenu>
        </Border.ContextMenu>

        <ItemsControl ItemsSource="{Binding Buttons}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="{Binding PanelOrientation}"
                               MaxWidth="{Binding PanelMaxWidth}"
                               MaxHeight="{Binding PanelMaxHeight}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:KeyButtonViewModel}">
                    <Button Style="{StaticResource KeyButtonStyle}"
                            Command="{Binding SendCommand}"
                            Background="{Binding CurrentBackground, Converter={StaticResource ColorToBrush}}"
                            ToolTip="{Binding TooltipText}"
                            ToolTipService.InitialShowDelay="500">
                        <Grid>
                            <TextBlock x:Name="IconText"
                                       Text="{Binding DisplayText}"
                                       FontFamily="Segoe UI, Segoe UI Emoji"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <Image x:Name="IconImage"
                                   Source="{Binding ImagePath}"
                                   Width="26"
                                   Height="26"
                                   Stretch="Uniform" />
                        </Grid>
                    </Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                            <Setter TargetName="IconText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>

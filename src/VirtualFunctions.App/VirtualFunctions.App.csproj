<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>VirtualFunctions</AssemblyName>
    <RootNamespace>VirtualFunctions.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>Virtual Functions</Product>
    <AssemblyTitle>Virtual Functions</AssemblyTitle>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtualFunctions.Core\VirtualFunctions.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <!-- Debug only: stage the real v1 files next to the exe so the one-time migration
       can be exercised during development. Never shipped. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Include="..\..\config.json" Link="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\presets\*.json" LinkBase="presets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
